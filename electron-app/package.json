{
  "name": "inkwell",
  "productName": "Inkwell",
  "desktopName": "com.inkwell.app.desktop",
  "version": "1.0.0",
  "description": "Inkwell — Cuaderno de manuscritos Markdown",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "author": "Inkwell",
  "homepage": "https://gitlab.com/ada-arg/fountain",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/ada-arg/fountain.git"
  },
  "bugs": {
    "url": "https://gitlab.com/ada-arg/fountain/-/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir --publish never",
    "build:win": "npm run build && electron-builder --win --x64 --publish never && node scripts/release.mjs prepare windows",
    "build:win:installer": "npm run build && electron-builder --win nsis --x64 --publish never",
    "build:linux": "npm run build && electron-builder --linux --x64 --publish never && node scripts/release.mjs prepare linux",
    "release:check": "node scripts/release.mjs check",
    "release:publish": "node scripts/release.mjs publish",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "check": "npm run lint -- --max-warnings=0 && npm test && npm run build",
    "test:electron": "npm run build && electron tests/electron-smoke.cjs --headless --ozone-platform=headless",
    "test:packaged": "electron tests/electron-smoke.cjs --headless --ozone-platform=headless --packaged"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "docx": "^9.8.1",
    "jszip": "^3.10.1",
    "markdown-it": "^14.3.3",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
